{
  "name": "products_v1",
  "default_sorting_field": "updated_at_unix",
  "token_separators": ["-", "_", "/", ".", "+"],
  "fields": [
    { "name": "id",                "type": "string"  },
    { "name": "handle",            "type": "string"  },
    { "name": "handle_shopify",    "type": "string", "index": false, "optional": true },
    { "name": "title",             "type": "string"  },
    { "name": "description_text",  "type": "string", "optional": true },
    { "name": "vendor",            "type": "string", "facet": true },
    { "name": "product_type",      "type": "string", "facet": true, "optional": true },
    { "name": "category",          "type": "string", "facet": true, "optional": true },
    { "name": "tags",              "type": "string[]", "facet": true, "optional": true },
    { "name": "components",        "type": "string[]", "facet": true, "optional": true },
    { "name": "option1_name",      "type": "string", "facet": true, "optional": true },
    { "name": "option2_name",      "type": "string", "facet": true, "optional": true },
    { "name": "option3_name",      "type": "string", "facet": true, "optional": true },
    { "name": "option1_values",    "type": "string[]", "facet": true, "optional": true },
    { "name": "option2_values",    "type": "string[]", "facet": true, "optional": true },
    { "name": "option3_values",    "type": "string[]", "facet": true, "optional": true },
    { "name": "skus",              "type": "string[]", "optional": true },
    { "name": "image_primary",     "type": "string", "index": false, "optional": true },
    { "name": "image_count",       "type": "int32", "optional": true },
    { "name": "price_min",         "type": "float", "facet": true, "optional": true },
    { "name": "price_max",         "type": "float", "facet": true, "optional": true },
    { "name": "has_price",         "type": "bool",  "facet": true },
    { "name": "variant_count",     "type": "int32", "optional": true },
    { "name": "updated_at_unix",   "type": "int64"   }
  ]
}