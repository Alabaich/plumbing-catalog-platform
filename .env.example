# Copy to .env and fill in. Placeholders only — never commit real values.
# One file serves every container (env_file: .env in docker-compose.prod.yml).

# === Database (Postgres runs on the HOST, not in Docker) ===
POSTGRES_USER=plumbing_app
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=plumbing_products
DATABASE_URL=postgresql://plumbing_app:CHANGE_ME@host.docker.internal:5432/plumbing_products
DB_HOST=host.docker.internal
DB_PORT=5432

# === Redis (rate limits, proxy cache + nonces, RQ enrichment queue) ===
REDIS_URL=redis://redis:6379/0

# === Typesense ===
TYPESENSE_API_KEY=CHANGE_ME
TYPESENSE_HOST=typesense
TYPESENSE_PORT=8108
# TYPESENSE_PROTOCOL=http

# === Telegram alerts (one bot, three channels) ===
TELEGRAM_BOT_TOKEN=CHANGE_ME
# Scraper errors (crashes, failed brands)
TG_CHAT_ERRORS=CHANGE_ME
# Status updates (cycle start/end, stats)
TG_CHAT_STATUS=CHANGE_ME
# Changes: enrichment results held for review
TG_CHAT_CHANGES=CHANGE_ME
# Fallback: one chat for everything
# TELEGRAM_CHAT_ID=CHANGE_ME

# === Orchestrator ===
PAUSE_BETWEEN_BRANDS=30
PAUSE_BETWEEN_CYCLES=3600
# RUN_ONCE=true            # single cycle, then exit (testing)
# CHROME_HEADLESS=true
# PAGE_LOAD_TIMEOUT=20

# === LLM enrichment (optional — leave LLM_API_KEY empty to skip the step) ===
# gemini | openai (any OpenAI-compatible API)
LLM_PROVIDER=gemini
LLM_API_KEY=
# Model id of your provider. Example value — check the provider's current model list.
# With LLM_PROVIDER=openai use an OpenAI-compatible id instead, e.g. gpt-4o-mini.
LLM_MODEL=gemini-2.5-flash-lite
# LLM_BASE_URL=            # OpenAI-compatible gateway or self-hosted endpoint
# LLM_TIMEOUT=120
# LLM_POISON_CHECK=true    # second LLM call that screens scraped text for prompt injection
# ENRICH_QUEUE=enrichment
# ENRICH_MAX_PER_BRAND=200 # products enqueued per brand per cycle

# === Example scrapers (services/scrapers/brands/brand_a|b|c) ===
# Brand name is stored as the vendor; URLs are the site root and its category
# listing pages, comma-separated. Production values are kept private.
BRAND_A_NAME=BRAND_A
BRAND_A_BASE_URL=https://brand-a.example.com
BRAND_A_CATEGORY_URLS=https://brand-a.example.com/category-one,https://brand-a.example.com/category-two
BRAND_B_NAME=BRAND_B
BRAND_B_BASE_URL=https://brand-b.example.com
BRAND_B_CATEGORY_URLS=https://brand-b.example.com/category-one,https://brand-b.example.com/category-two
BRAND_C_NAME=BRAND_C
BRAND_C_BASE_URL=https://brand-c.example.com
BRAND_C_CATEGORY_URLS=https://brand-c.example.com/category-one,https://brand-c.example.com/category-two

# === API ===
API_ENV=production
# Shared key the Remix app sends as X-API-Key (API_KEY and BACKEND_API_KEY must match)
API_KEY=CHANGE_ME
BACKEND_API_KEY=CHANGE_ME
# Signs API responses
API_SIGNING_SECRET=CHANGE_ME
# Encrypts pagination cursors
CURSOR_SECRET=CHANGE_ME
CORS_ORIGINS=https://*.myshopify.com
# CORS_ORIGIN_REGEX=https://[a-z0-9\-]+\.myshopify\.com
# PROXY_TIMESTAMP_TTL=60
# PROXY_NONCE_TTL=120
# REDIS_PROXY_CACHE_TTL=3600
# Anti-scrape scoring: weight added to the anomaly score per signal, and the
# score at which a request is blocked. Neutral example values.
ANTI_SCRAPE_WEIGHT_SCRIPT_UA=0.5
ANTI_SCRAPE_WEIGHT_HEADLESS_UA=0.5
ANTI_SCRAPE_WEIGHT_NO_REFERER=0.5
ANTI_SCRAPE_WEIGHT_FOREIGN_REFERER=0.5
ANTI_SCRAPE_WEIGHT_MISSING_HEADERS=0.5
ANTI_SCRAPE_BLOCK_SCORE=1.0
# Rate limits: requests per minute per tier, and the scores that select a tier
RATE_LIMIT_NORMAL_PER_MIN=60
RATE_LIMIT_LOW_PER_MIN=30
RATE_LIMIT_MEDIUM_PER_MIN=10
RATE_LIMIT_LOW_SCORE=0.25
RATE_LIMIT_MEDIUM_SCORE=0.5
# SESSION_DATABASE_URL=    # only if Shopify sessions live in a different database

# === Shopify app (Remix) ===
SHOPIFY_API_KEY=CHANGE_ME
SHOPIFY_API_SECRET=CHANGE_ME
SCOPES=write_products,read_products,write_price_rules,read_price_rules
SHOPIFY_APP_URL=https://admin.example.com
API_BASE_URL=http://api:8000
# DEV_TUNNEL_HOST=         # vite dev server: hostname of your ngrok tunnel

# === Caddy ===
API_DOMAIN=api.example.com
ADMIN_DOMAIN=admin.example.com

# === Proxy smoke tests (scripts/run_proxy_tests.py) ===
# PROXY_TEST_API_BASE=http://localhost:8000
# PROXY_TEST_SHOP=example-store.myshopify.com
# PROXY_TEST_HANDLE=example-product-handle
# PROXY_TEST_VENDOR=EXAMPLE
