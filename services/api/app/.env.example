# Local development outside Docker. app/config.py loads services/api/.env.
# Placeholders only — the full list of variables is in the root .env.example.

# Database connection (PostgreSQL)
DATABASE_URL=postgresql://USERNAME:PASSWORD@localhost:5432/plumbing_products

# Shared key expected in the X-API-Key header
API_KEY=CHANGE_ME

# Signs API responses (any long random string)
API_SIGNING_SECRET=CHANGE_ME

# Encrypts pagination cursors (any long random string)
CURSOR_SECRET=CHANGE_ME

# Shopify app secret — verifies App Proxy signatures
SHOPIFY_API_SECRET=CHANGE_ME

# Redis: rate limiting, proxy cache and nonces
REDIS_URL=redis://localhost:6379/0

# Typesense
TYPESENSE_HOST=localhost
TYPESENSE_PORT=8108
TYPESENSE_API_KEY=CHANGE_ME

# Environment (development or production)
API_ENV=development
